#!/usr/bin/env bash

set -Eeuo pipefail

umask 077

BACKUP_DIR="/var/backups/dh-conversions"
KEY_FILE="/etc/dh-conversions/backup-passphrase"
DB_NAME="${DH_CONVERSIONS_DB_NAME:-shopify_db}"
RETENTION_DAYS="${DH_CONVERSIONS_BACKUP_RETENTION_DAYS:-30}"
TIMESTAMP="$(date -u +%Y%m%dT%H%M%S%NZ)"
FINAL_FILE="${BACKUP_DIR}/${DB_NAME}-${TIMESTAMP}.dump.gpg"
PART_FILE="${FINAL_FILE}.part"
export GNUPGHOME="/run/dh-conversions-backup/gnupg"
CHECKSUM_FILE="${FINAL_FILE}.sha256"
VERIFY_FILE="${GNUPGHOME}/verify-${TIMESTAMP}.dump"


cleanup() {
  rm -f \
    "$PART_FILE" \
    "$VERIFY_FILE"
}

trap cleanup EXIT

install \
  -d \
  -m 0700 \
  "$BACKUP_DIR" \
  "$GNUPGHOME"

if [ ! -r "$KEY_FILE" ]; then
  echo "Backup encryption key is missing."
  exit 1
fi

/usr/bin/pg_dump \
    --format=custom \
    --no-owner \
    --no-privileges \
    "$DB_NAME" \
  | /usr/bin/gpg \
      --batch \
      --yes \
      --pinentry-mode loopback \
      --passphrase-file "$KEY_FILE" \
      --symmetric \
      --cipher-algo AES256 \
      --compress-algo none \
      --output "$PART_FILE"

test -s \
  "$PART_FILE"

/usr/bin/gpg \
  --batch \
  --quiet \
  --yes \
  --pinentry-mode loopback \
  --passphrase-file "$KEY_FILE" \
  --output "$VERIFY_FILE" \
  --decrypt \
  "$PART_FILE"

test -s \
  "$VERIFY_FILE"

/usr/bin/pg_restore \
  --list \
  "$VERIFY_FILE" \
  >/dev/null

rm -f \
  "$VERIFY_FILE"

mv \
  "$PART_FILE" \
  "$FINAL_FILE"

(
  cd "$BACKUP_DIR"

  /usr/bin/sha256sum \
    "$(basename "$FINAL_FILE")" \
    > "$(basename "$CHECKSUM_FILE")"
)

find \
  "$BACKUP_DIR" \
  -maxdepth 1 \
  -type f \
  \( \
    -name '*.dump.gpg' \
    -o -name '*.dump.gpg.sha256' \
  \) \
  -mtime "+${RETENTION_DAYS}" \
  -delete

echo "Encrypted backup created:"
echo "$(basename "$FINAL_FILE")"
