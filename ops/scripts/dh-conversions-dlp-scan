#!/usr/bin/env bash

set -Eeuo pipefail

/usr/bin/journalctl \
  -u dh-conversions.service \
  -u dh-orders-worker.service \
  --since "24 hours ago" \
  --no-pager \
  -o cat \
  | /usr/bin/python3 -c '
import re
import sys

text = sys.stdin.read()

patterns = {
    "email_like_values":
        re.compile(
            r"\b[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}\b",
            re.IGNORECASE,
        ),

    "bearer_tokens":
        re.compile(
            r"\bbearer\s+[A-Za-z0-9._~+/\-=]{12,}",
            re.IGNORECASE,
        ),

    "google_oauth_tokens":
        re.compile(
            r"\bya29\.[A-Za-z0-9._\-]{12,}",
        ),

    "meta_style_tokens":
        re.compile(
            r"\bEAA[A-Za-z0-9]{30,}\b",
        ),

    "shopify_tokens":
        re.compile(
            r"\bshp(?:at|ca|ss)_[A-Za-z0-9]{20,}\b",
            re.IGNORECASE,
        ),

    "secret_assignments":
        re.compile(
            r"""
            \b
            (
              access[_-]?token|
              refresh[_-]?token|
              api[_-]?secret|
              client[_-]?secret|
              password
            )
            \b
            ["\x27]?
            \s*
            [:=]
            \s*
            ["\x27]
            [^"\x27\s]{8,}
            """,
            re.IGNORECASE |
            re.VERBOSE,
        ),

    "private_key_markers":
        re.compile(
            r"-----BEGIN (?:RSA |EC |OPENSSH )?PRIVATE KEY-----",
            re.IGNORECASE,
        ),
}

counts = {
    name:
        len(
            pattern.findall(
                text
            )
        )
    for name, pattern
    in patterns.items()
}

print(
    f"journal_lines_scanned: {len(text.splitlines())}"
)

for name, count in counts.items():
    print(
        f"{name}: {count}"
    )

if any(
    count > 0
    for count in counts.values()
):
    print(
        "DLP scan status: prohibited data pattern detected."
    )

    raise SystemExit(2)

print(
    "DLP scan status: passed."
)
'
