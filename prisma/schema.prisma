// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model ShopSettings {
  id              Int        @id @default(autoincrement())
  shop            String     @unique // e.g. "my-store.myshopify.com"
  ga4Id           String? // G-XXXXXX
  googleAdsId     String? // AW-XXXXXX
  facebookPixelId String?
  tiktokPixelId   String?
  pinterestTagId  String?
  linkedinPid     String?
  bingUetTagId    String?
  workspaceId     String? // Link to workspace
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

// User model for authentication
model User {
  id                   String            @id @default(cuid())
  email                String            @unique
  passwordHash         String? // Null for OAuth-only users
  firebaseUid          String?           @unique // Firebase Authentication UID
  name                 String?
  role                 UserRole          @default(USER)
  emailVerified        Boolean           @default(false)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]
}

// Workspace model for multi-tenancy
model Workspace {
  id                         String                      @id @default(cuid())
  name                       String
  slug                       String                      @unique
  ownerId                    String
  owner                      User                        @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members                    WorkspaceMember[]
  shopSettings               ShopSettings[]
  platformConnections        PlatformConnection[]
  googleConversionConfigs    GoogleConversionConfig[]
  googleAdsConversionActions GoogleAdsConversionAction[]
  assetSelections            ShopAssetSelection[]
  platformDeliverySettings   PlatformDeliverySetting[]
  platformServerCredentials  PlatformServerCredential[]
  eventDeliveryLogs          EventDeliveryLog[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  @@index([ownerId])
}

// Workspace membership with roles
model WorkspaceMember {
  id          String     @id @default(cuid())
  workspaceId String
  userId      String
  role        MemberRole @default(MEMBER)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
}

// Platform OAuth connections (for Phase 2)
model PlatformConnection {
  id             String    @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform       Platform
  accountId      String // Platform-specific account ID
  accountName    String?
  accessToken    String // Encrypted
  refreshToken   String? // Encrypted
  tokenExpiresAt DateTime?
  scopes         String[]
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([workspaceId, platform, accountId])
  @@index([workspaceId])
}

model ShopAssetSelection {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform   String
  assetType  String
  assetValue String
  assetLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, platform, assetType])
  @@index([workspaceId])
}

model GoogleAdsConversionAction {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  googleAdsCustomerId String
  eventName           String
  conversionName      String
  conversionActionId  String?
  conversionId        String?
  conversionLabel     String?
  resourceName        String
  category            String?
  reused              Boolean @default(false)
  deliveryMode        String  @default("server")
  isPrimary           Boolean @default(true)
  isActive            Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([googleAdsCustomerId])
  @@index([workspaceId, googleAdsCustomerId, eventName])
  @@index([workspaceId, googleAdsCustomerId, conversionActionId])
}

model GoogleConversionConfig {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  googleAdsCustomerId String
  setupType           String
  conversionName      String?
  conversionValueMode String   @default("dynamic")
  events              String[]
  isActive            Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, googleAdsCustomerId])
  @@index([workspaceId])
}

// OAuth state for CSRF protection

model PlatformDeliverySetting {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform          String
  clientSideEnabled Boolean @default(true)
  serverSideEnabled Boolean @default(false)
  deliveryMode      String  @default("client")
  testCode          String?
  isActive          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, platform])
  @@index([workspaceId])
}

model PlatformServerCredential {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  platform  String
  assetType String
  assetId   String
  assetName String?

  accessToken String?
  apiSecret   String?

  tokenStatus     String    @default("not_configured")
  lastValidatedAt DateTime?
  testCode        String?
  isActive        Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, platform, assetType, assetId])
  @@index([workspaceId])
}

model EventDeliveryLog {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  shop      String?
  eventId   String
  eventName String

  platform     String  @default("internal")
  deliveryType String  @default("server")
  status       String
  message      String?

  requestPayload  Json?
  responsePayload Json?

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([shop])
  @@index([eventId])
  @@index([platform])
}

model OAuthState {
  id          String   @id @default(cuid())
  state       String   @unique
  workspaceId String
  platform    Platform
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([state])
  @@index([expiresAt])
}

// Enums
enum UserRole {
  ADMIN
  USER
  VIEWER
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Platform {
  GOOGLE_ADS
  GOOGLE_ANALYTICS
  META
  TIKTOK
  PINTEREST
  LINKEDIN
  MICROSOFT_ADS
  SHOPIFY
}
